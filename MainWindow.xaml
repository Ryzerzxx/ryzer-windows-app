<Window x:Class="RyzerDNS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RyzerDNS Client"
        Height="700" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Icon="Assets/nav-logo.png"
        FontFamily="{StaticResource AppFont}">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="AppTaskbarInfo" Description="RyzerDNS Client"/>
    </Window.TaskbarItemInfo>

    <!-- Window Frame with 20px Rounded Corners, Deep Shadow & Linear Background Gradient -->
    <Border BorderBrush="{StaticResource GlassCardBorder}"
            BorderThickness="1.2"
            CornerRadius="20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#040407" Offset="0.0"/>
                <GradientStop Color="#090910" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.85" Direction="270" ShadowDepth="8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/> <!-- TitleBar -->
                <RowDefinition Height="*"/>  <!-- Main Content Area -->
            </Grid.RowDefinitions>

            <!-- 1. Header (TitleBar): RYZERDNS Capital Logotype & Larger Logo on Right, Controls on Left -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Left: Glass Window Controls & Logout -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/> <!-- Right: Official Syne RYZERDNS Logotype & Logo -->
                </Grid.ColumnDefinitions>

                <!-- Left Side: Minimal Glass Buttons (Logout, About, Minimize, Close) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- Minimal Red Logout Icon Button -->
                    <Button x:Name="BtnLogout" Click="BtnLogout_Click" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <Path Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"
                                          Fill="{StaticResource AccentRed}"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#240C14"/>
                                        <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- About / Info Glass Button (Red Themed) -->
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="BtnAbout_Click" Cursor="Hand" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBdr" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <Path x:Name="btnIcon"
                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                                          Fill="{StaticResource AccentRed}"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBdr" Property="Background" Value="#240C14"/>
                                        <Setter TargetName="btnBdr" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Minimize Glass Button -->
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="BtnMinimize_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBdr" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="—" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBdr" Property="Background" Value="#171728"/>
                                        <Setter TargetName="btnBdr" Property="BorderBrush" Value="#2A2A44"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close Glass Button -->
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand" Margin="4,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBdr" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBdr" Property="Background" Value="{StaticResource AccentRed}"/>
                                        <Setter TargetName="btnBdr" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Right Side: Official Syne RYZERDNS Capital Logotype (Aligned & Enhanced) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" SnapsToDevicePixels="True">
                    <TextBlock Text="RYZER" FontSize="16" FontWeight="ExtraBold" FontFamily="{StaticResource LogoFont}" Foreground="#FFFFFF" VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                    <TextBlock Text="DNS" FontSize="16" FontWeight="ExtraBold" FontFamily="{StaticResource LogoFont}" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center" Margin="0,0,9,0"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                    <Image Source="Assets/nav-logo.png" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 2. Main Content Area -->
            <Grid Grid.Row="1" Margin="22,4,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Auto-Update Banner -->
                    <RowDefinition Height="*"/>    <!-- Main Content Panels -->
                </Grid.RowDefinitions>

                <!-- Sleek Glass Silent Auto-Update Ready Banner (Telegram Style) -->
                <Border Grid.Row="0" x:Name="UpdateBanner" Visibility="Collapsed" Opacity="0"
                        Background="#1E1606" BorderBrush="{StaticResource AccentYellow}" BorderThickness="1"
                        CornerRadius="10" Padding="12,8" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="BtnRestartUpdate_Click">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BannerTranslate" Y="-30"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Color="#FFB300" Opacity="0.35" ShadowDepth="0"/>
                    </Border.Effect>
                    <Grid FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Glowing Pulse Indicator Dot -->
                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource AccentYellow}" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#FFB300" Opacity="0.8" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Update Ready Text -->
                        <TextBlock Grid.Column="1" Text="نسخه جدید RyzerDNS آماده است!"
                                   FontSize="12" FontWeight="Bold" Foreground="#FFF3D6" VerticalAlignment="Center"
                                   TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>

                        <!-- Restart Button / Pill -->
                        <Button Grid.Column="2" Click="BtnRestartUpdate_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdr" Background="#33FFB300" BorderBrush="{StaticResource AccentYellow}" BorderThickness="1"
                                            CornerRadius="7" Padding="10,3" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="راه‌اندازی مجدد" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentYellow}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#55FFB300"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Nested Panels Container -->
                <Grid Grid.Row="1">

                    <!-- 2.1 LOGIN PANEL -->
                    <Grid x:Name="LoginPanel" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center">

                        <!-- Brand Hero Emblem (Clean, Transparent, No Background, No Red Glow) -->
                        <Image Source="Assets/nav-logo.png"
                               Height="64"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18"/>

                        <!-- Section Title -->
                        <TextBlock Text="ورود به حساب کاربری"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"
                                   FlowDirection="RightToLeft"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType"/>

                        <!-- Glass Login Form Card -->
                        <Border Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="16" Padding="20,22">
                            <Grid>
                                <!-- Top Subtle Glass Reflex Highlight Line -->
                                <Border Height="1" Background="#FFFFFF" Opacity="0.06" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,-22,0,0"/>

                                <StackPanel>
                                    <!-- Username -->
                                    <TextBlock Text="نام کاربری یا ایمیل"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,0,0,6"
                                               FlowDirection="RightToLeft"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                    <TextBox x:Name="TxtUsername" Style="{StaticResource CyberTextBox}" FlowDirection="LeftToRight"/>

                                    <!-- Password -->
                                    <TextBlock Text="رمز عبور"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,14,0,6"
                                               FlowDirection="RightToLeft"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                    <PasswordBox x:Name="TxtPassword" Style="{StaticResource CyberPasswordBox}" FlowDirection="LeftToRight"/>

                                    <!-- Remember Me -->
                                    <CheckBox x:Name="ChkRememberMe"
                                              Content="مرا به خاطر بسپار"
                                              IsChecked="True"
                                              Foreground="{StaticResource TextSecondary}"
                                              Margin="0,12,0,0"
                                              FlowDirection="RightToLeft"
                                              Cursor="Hand"
                                              FontSize="11.5"/>

                                    <!-- Metallic Red Gradient Login Button -->
                                    <Button x:Name="BtnLogin" Click="BtnLogin_Click" Margin="0,18,0,0" Height="48" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBdr" CornerRadius="12">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF3B5C" Offset="0.0"/>
                                                            <GradientStop Color="#D01435" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="16" Color="#FF3B5C" Opacity="0.35" Direction="270" ShadowDepth="2"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="ورود به حساب کاربری"
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FlowDirection="RightToLeft"
                                                               TextOptions.TextFormattingMode="Display"
                                                               TextOptions.TextRenderingMode="ClearType"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBdr" Property="Opacity" Value="0.92"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="btnBdr" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Google Login Button -->
                                    <Button x:Name="BtnGoogleLogin" Click="BtnGoogleLogin_Click" Margin="0,10,0,0" Height="46" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="gBdr" CornerRadius="12" Background="#141422" BorderBrush="#2A2A40" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="ورود سریع با حساب گوگل"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"
                                                                   VerticalAlignment="Center"
                                                                   FlowDirection="RightToLeft"
                                                                   Margin="0,0,10,0"
                                                                   TextOptions.TextFormattingMode="Display"
                                                                   TextOptions.TextRenderingMode="ClearType"/>
                                                        <Path Width="18" Height="18" Stretch="Uniform" Fill="#EA4335" VerticalAlignment="Center"
                                                              Data="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5zm0 14c-3 0-5.5-2.4-6.4-5.2L1.9 16.7C3.7 20.4 7.5 23 12 23c2.9 0 5.4-.9 7.2-2.5l-3.5-2.8c-1 .7-2.3 1.3-3.7 1.3zm11-7c0-.8-.1-1.6-.2-2.3H12v4.5h6.3c-.3 1.5-1.1 2.8-2.3 3.6l3.5 2.8c2.1-1.9 3.5-4.8 3.5-8.6z"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="gBdr" Property="Background" Value="#1C1C30"/>
                                                        <Setter TargetName="gBdr" Property="BorderBrush" Value="#444466"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="gBdr" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Error Box -->
                                    <Border x:Name="LoginErrorBorder" Background="#260C14" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtLoginError"
                                                   Text="خطا رخ داد"
                                                   FontSize="11.5"
                                                   Foreground="#FF99AA"
                                                   TextWrapping="Wrap"
                                                   FlowDirection="RightToLeft"
                                                   HorizontalAlignment="Center"
                                                   TextOptions.TextFormattingMode="Display"
                                                   TextOptions.TextRenderingMode="ClearType"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Website Registration Link -->
                        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FlowDirection="RightToLeft">
                            <Hyperlink Click="Hyperlink_Click" Foreground="{StaticResource TextSecondary}" TextDecorations="None" Cursor="Hand" FontSize="12">
                                <Run Text="حساب کاربری ندارید؟ ثبت‌نام و خرید اشتراک در "/>
                                <Run Text="ryzerdns.ir" Foreground="{StaticResource AccentRed}" FontWeight="Bold"/>
                            </Hyperlink>
                        </TextBlock>

                        <!-- Ultra-Sleek Minimal Footer Bar (Login Panel): وب‌سایت رسمی • کانال تلگرام • بات تلگرام -->
                        <Border Height="34" Background="#0C0C16" BorderBrush="#1C1C2E"
                                BorderThickness="1" CornerRadius="17" Padding="8,0" Margin="0,14,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Click="BtnOpenWebsite_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0" Margin="2,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                                <TextBlock x:Name="txt" Text="وب‌سایت" FontSize="11.5" FontWeight="SemiBold" Foreground="#82829E" VerticalAlignment="Center"
                                                           TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="pill" Property="Background" Value="#171728"/>
                                                    <Setter TargetName="pill" Property="BorderBrush" Value="#2A2A42"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="•" FontSize="10" Foreground="#323246" VerticalAlignment="Center" Margin="2,0"/>
                                <Button Click="BtnOpenTelegram_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0" Margin="2,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                                <TextBlock x:Name="txt" Text="کانال تلگرام" FontSize="11.5" FontWeight="SemiBold" Foreground="#82829E" VerticalAlignment="Center"
                                                           TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="pill" Property="Background" Value="#171728"/>
                                                    <Setter TargetName="pill" Property="BorderBrush" Value="#2A2A42"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="•" FontSize="10" Foreground="#323246" VerticalAlignment="Center" Margin="2,0"/>
                                <Button Click="BtnOpenBot_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0" Margin="2,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                                <TextBlock x:Name="txt" Text="بات تلگرام" FontSize="11.5" FontWeight="SemiBold" Foreground="#82829E" VerticalAlignment="Center"
                                                           TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="pill" Property="Background" Value="#171728"/>
                                                    <Setter TargetName="pill" Property="BorderBrush" Value="#2A2A42"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2.2 CYBER DASHBOARD PANEL -->
                <Grid x:Name="DashboardPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- User Profile Glass Section -->
                        <RowDefinition Height="Auto"/> <!-- IP Management Glass Section -->
                        <RowDefinition Height="*"/>    <!-- Cyber-Core Switch in Center -->
                        <RowDefinition Height="Auto"/> <!-- Symmetrical Glass Ping Card -->
                        <RowDefinition Height="Auto"/> <!-- Community Links & Version Info Bar -->
                    </Grid.RowDefinitions>

                    <!-- 1. User Profile Glass Section (Above Switch) -->
                    <Border Grid.Row="0" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="14" Padding="16,11">
                        <Grid>
                            <!-- Top Subtle Glass Reflex Highlight Line -->
                            <Border Height="1" Background="#FFFFFF" Opacity="0.05" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,-11,0,0"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Left: Remaining Days -->
                                    <ColumnDefinition Width="*"/>    <!-- Right: Username + PRO Pill -->
                                </Grid.ColumnDefinitions>

                                <!-- Remaining Days (Persian format, e.g. "۱۲۴ روز باقیمانده") -->
                                <TextBlock Grid.Column="0"
                                           x:Name="TxtPlanExpires"
                                           Text="در حال بررسی..."
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentRed}"
                                           VerticalAlignment="Center"
                                           FlowDirection="RightToLeft"
                                           TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextRenderingMode="ClearType"/>

                                <!-- Username + PRO Glass Pill on the Right -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDisplayName"
                                               Text="کاربر رایزر"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>

                                    <!-- PRO Glass Pill: rgba(255, 59, 92, 0.15) background with neon red border -->
                                    <Border x:Name="BadgePlan" Background="#26FF3B5C" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPlanTier" Text="PRO" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource AccentRed}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 1.5 IP Management Cyber-Glass Card (Row 1) -->
                    <Border Grid.Row="1" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,8,0,0">
                        <Grid>
                            <!-- Top Subtle Glass Reflex Highlight Line -->
                            <Border Height="1" Background="#FFFFFF" Opacity="0.05" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,-10,0,0"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Icon + Label on Right, Status Badge on Left (RTL Flow) -->
                                <Grid Grid.Row="0" FlowDirection="RightToLeft" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Right: Icon + Label -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1A00E5FF" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0">
                                            <TextBlock Text="🌐" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="آدرس آی‌پی سیستم" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Left: Status Badge Pill -->
                                    <Border Grid.Column="1" x:Name="BadgeIpStatus" Background="#1A00E676" BorderBrush="#6600E676" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="DotIpStatus" Width="6" Height="6" Fill="#00E676" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtIpStatus" Text="همگام و ثبت‌شده" FontSize="10" FontWeight="Bold" Foreground="#00E676" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Middle Row: IP Display Box on Right + Register Button on Left -->
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- IP Address Display Box -->
                                    <Border Grid.Column="0" Background="#0A0A14" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Height="36" Padding="10,0" Margin="0,0,8,0">
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDetectedIp" Text="در حال بررسی..." FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource LogoFont}" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Manual Register / Sync Button -->
                                    <Button Grid.Column="1" x:Name="BtnRegisterIp" Click="BtnRegisterIp_Click" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBdr" Background="{StaticResource AccentRed}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="14,0" VerticalAlignment="Stretch">
                                                    <TextBlock x:Name="BtnRegisterText" Text="ثبت آی‌پی" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBdr" Property="Background" Value="#FF1744"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="btnBdr" Property="Opacity" Value="0.6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Bottom Helper Note: 1-minute auto-check indicator -->
                                <TextBlock Grid.Row="2" Text="• بررسی خودکار هر ۱ دقیقه فعال است (تغییر شبکه خودکار ثبت می‌شود)." FontSize="10" Foreground="#66FFFFFF" FlowDirection="RightToLeft"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2. Cyber-Core Switch Area in Center -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">

                        <!-- Luxury Minimalist Cyber-Glass Power Switch (Diameter 154) -->
                        <Button x:Name="BtnConnect" Click="BtnConnect_Click" Width="154" Height="154" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <!-- Layer 0: Soft Ambient Aura Glow behind the button -->
                                        <Ellipse x:Name="AmbientGlow" Width="146" Height="146" Fill="#26FF3B5C">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="GlowEffect" BlurRadius="45" Color="#FF3B5C" Opacity="0.4" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>

                                        <!-- Layer 1: Ambient Track Line (Ultra-thin 1px guide ring) -->
                                        <Ellipse x:Name="OrbitTrack" Width="146" Height="146"
                                                 Stroke="#18FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>

                                        <!-- Layer 2: Silky Smooth Laser Arc (Connecting State) -->
                                        <Ellipse x:Name="OrbitSpinner" Width="146" Height="146"
                                                 StrokeThickness="2.8" StrokeDashCap="Round" StrokeDashArray="24 65"
                                                 RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Ellipse.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFA726" Offset="0.0"/>
                                                    <GradientStop Color="#FF3B5C" Offset="0.6"/>
                                                    <GradientStop Color="Transparent" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Stroke>
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="16" Color="#FFA726" Opacity="0.8" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>

                                        <!-- Layer 3: Outer Bezel Rim Ring (Frosted Dark Glass Ring) -->
                                        <Border x:Name="OuterRim" Width="134" Height="134" CornerRadius="67"
                                                BorderThickness="1.5" Background="#0A0A12">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#4A1420" Offset="0.0"/>
                                                    <GradientStop Color="#18080C" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                        </Border>

                                        <!-- Layer 4: Main Tactile Glass Switch Disc -->
                                        <Border x:Name="InnerDisc" Width="118" Height="118" CornerRadius="59" BorderThickness="1.2">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#6B1828" Offset="0.0"/>
                                                    <GradientStop Color="#22060C" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#240B13" Offset="0.0"/>
                                                    <GradientStop Color="#100408" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.6" Direction="270" ShadowDepth="3"/>
                                            </Border.Effect>

                                            <Grid>
                                                <!-- Top Specular Glass Crescent Highlight -->
                                                <Border CornerRadius="59 59 18 18" Height="42" VerticalAlignment="Top" Margin="6,2,6,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                                            <GradientStop Color="Transparent" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Opacity>0.08</Border.Opacity>
                                                </Border>

                                                <!-- Center Icon & Typography -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Modern Power SVG Icon -->
                                                    <Path x:Name="PowerIcon"
                                                          Data="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z"
                                                          Fill="#FFFFFF"
                                                          Width="34" Height="34"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center">
                                                        <Path.Effect>
                                                            <DropShadowEffect x:Name="IconGlow" BlurRadius="12" Color="#FF3B5C" Opacity="0.4" ShadowDepth="0"/>
                                                        </Path.Effect>
                                                    </Path>

                                                    <!-- Button State Label -->
                                                    <TextBlock x:Name="TxtBtnState"
                                                               Text="اتصال"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="#FFFFFF"
                                                               Margin="0,6,0,0"
                                                               HorizontalAlignment="Center"
                                                               FlowDirection="RightToLeft"
                                                               TextOptions.TextFormattingMode="Display"
                                                               TextOptions.TextRenderingMode="ClearType"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="InnerDisc" Property="Opacity" Value="0.94"/>
                                            <Setter TargetName="AmbientGlow" Property="Opacity" Value="0.95"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="InnerDisc" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" CenterX="59" CenterY="59"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Empty/Collapsed Connection Status (No text below button!) -->
                        <TextBlock x:Name="TxtConnectionStatus"
                                   Visibility="Collapsed"
                                   Height="0" Margin="0"/>
                    </StackPanel>

                    <!-- 3. Symmetrical Glass Ping Card (Center of Bottom) -->
                    <Border Grid.Row="3" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="14,0,14,6">
                        <Grid>
                            <!-- Top Subtle Glass Reflex Highlight Line -->
                            <Border Height="1" Background="#FFFFFF" Opacity="0.05" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,-12,0,0"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Left: Ping Dot, Value & Rotate Button -->
                                    <ColumnDefinition Width="*"/>    <!-- Right: Label -->
                                </Grid.ColumnDefinitions>

                                <!-- Left Side: Ping Value (Vibrant Green) + Refresh Rotate Button -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="PingDot" Width="9" Height="9" Fill="{StaticResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPingValue"
                                               Text="-- ms"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentGreen}"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>

                                    <!-- Small Glass Refresh / Rotate Button -->
                                    <Button x:Name="BtnRefreshPing" Click="BtnRefreshPing_Click" Width="26" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="rBdr" Background="#141422" BorderBrush="#202034" BorderThickness="1" CornerRadius="13">
                                                    <Path x:Name="RefreshPath"
                                                          Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                                          Fill="{StaticResource TextSecondary}"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="RefreshRotate" Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="rBdr" Property="Background" Value="#1E1E34"/>
                                                        <Setter TargetName="rBdr" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                                        <Setter TargetName="RefreshPath" Property="Fill" Value="{StaticResource AccentRed}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- Right Side: Label -->
                                <TextBlock Grid.Column="1"
                                           Text="تاخیر سرور (Ping)"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FlowDirection="RightToLeft"
                                           TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextRenderingMode="ClearType"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 4. Ultra-Sleek Minimal Footer Bar (Dashboard Panel): وب‌سایت رسمی • کانال تلگرام • بات تلگرام -->
                    <Border Grid.Row="4" Height="34" Background="#0C0C16" BorderBrush="#1C1C2E"
                            BorderThickness="1" CornerRadius="17" Padding="8,0" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Click="BtnOpenWebsite_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0" Margin="2,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                            <TextBlock x:Name="txt" Text="وب‌سایت" FontSize="11.5" FontWeight="SemiBold" Foreground="#82829E" VerticalAlignment="Center"
                                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pill" Property="Background" Value="#171728"/>
                                                <Setter TargetName="pill" Property="BorderBrush" Value="#2A2A42"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="•" FontSize="10" Foreground="#323246" VerticalAlignment="Center" Margin="2,0"/>
                            <Button Click="BtnOpenTelegram_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0" Margin="2,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                            <TextBlock x:Name="txt" Text="کانال تلگرام" FontSize="11.5" FontWeight="SemiBold" Foreground="#82829E" VerticalAlignment="Center"
                                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pill" Property="Background" Value="#171728"/>
                                                <Setter TargetName="pill" Property="BorderBrush" Value="#2A2A42"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="•" FontSize="10" Foreground="#323246" VerticalAlignment="Center" Margin="2,0"/>
                            <Button Click="BtnOpenBot_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0" Margin="2,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                            <TextBlock x:Name="txt" Text="بات تلگرام" FontSize="11.5" FontWeight="SemiBold" Foreground="#82829E" VerticalAlignment="Center"
                                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pill" Property="Background" Value="#171728"/>
                                                <Setter TargetName="pill" Property="BorderBrush" Value="#2A2A42"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>

            </Grid>

        </Grid>

            <!-- 3. IN-APP CUSTOM CYBER-GLASS MODAL DIALOG (Zero Windows Default Popups!) -->
            <Grid x:Name="ModalOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="2000">
                <!-- Backdrop Dimmer -->
                <Border Background="#E004040A"/>

                <!-- Floating Modal Card -->
                <Border Width="330" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#10101C" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1.2"
                        CornerRadius="18" Padding="22,24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="45" Color="#000000" Opacity="0.9" ShadowDepth="5" Direction="270"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Top Highlight Reflex -->
                        <Border Height="1" Background="#FFFFFF" Opacity="0.06" Margin="0,-24,0,18" HorizontalAlignment="Stretch"/>

                        <!-- Modal Icon Badge -->
                        <Border x:Name="ModalIconBorder" Width="50" Height="50" CornerRadius="25"
                                Background="#22FF3B5C" BorderBrush="{StaticResource AccentRed}" BorderThickness="1.5"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ModalIconShadow" BlurRadius="16" Color="#FF3B5C" Opacity="0.4" ShadowDepth="0"/>
                            </Border.Effect>
                            <Path x:Name="ModalIconPath"
                                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                  Fill="{StaticResource AccentRed}"
                                  Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Modal Title -->
                        <TextBlock x:Name="TxtModalTitle"
                                   Text="عنوان پیام"
                                   FontSize="14.5" FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FlowDirection="RightToLeft"
                                   Margin="0,0,0,10"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType"/>

                        <!-- Modal Message -->
                        <TextBlock x:Name="TxtModalMessage"
                                   Text="متن پیام..."
                                   FontSize="12"
                                   Foreground="#9E9EB8"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FlowDirection="RightToLeft"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight"
                                   Margin="8,0,8,22"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType"/>

                        <!-- Buttons Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Secondary Button (Cancel / Close) -->
                            <Button Grid.Column="0" x:Name="BtnModalSecondary" Click="BtnModalSecondary_Click" Height="40" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="#161626" BorderBrush="#25253C" BorderThickness="1" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdr" Property="Background" Value="#222238"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="TxtModalSecondaryBtn" Text="بستن" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Primary Button (Action / Confirm) -->
                            <Button Grid.Column="2" x:Name="BtnModalPrimary" Click="BtnModalPrimary_Click" Height="40" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF3B5C" Offset="0.0"/>
                                                    <GradientStop Color="#D01435" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14" Color="#FF3B5C" Opacity="0.35" ShadowDepth="1" Direction="270"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdr" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="TxtModalPrimaryBtn" Text="تایید" FontSize="12.5" FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
